{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'abandonments:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Amsterdam)',
    'github>home-operations/renovate-presets#12.0.0',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
  ],
  flux: {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: ['Auto-merge non-major updates from my own and home-operations packages'],
      matchPackageNames: [
        'ghcr.io/ronaldphilipsen/**',
        'ronaldphilipsen/**',
        'ghcr.io/home-operations/**',
        'home-operations/**',
        'ghcr.io/renovatebot/renovate',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      automerge: true,
    },
    {
      // Helm rejects "version: x@sha256:..." and Renovate cannot read the digest back,
      // which fails the whole pin-dependencies branch
      description: ['Do not pin digests of helmfile OCI charts'],
      matchManagers: ['helmfile'],
      pinDigests: false,
    },
  ],
  customManagers: [
    {
      // Kustomize resources pinned to a GitHub release tag, such as CRDs
      customType: 'regex',
      description: ['GitHub raw URLs pinned to a release tag'],
      managerFilePatterns: [
        '/(^|/)kustomization\\.yaml$/',
      ],
      matchStrings: [
        'https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v\\d[^/\\s]*)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
}
